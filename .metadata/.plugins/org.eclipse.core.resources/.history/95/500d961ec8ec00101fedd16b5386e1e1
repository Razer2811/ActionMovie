<%@page import="java.util.Date"%>
<%@page import="modal.Users"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Thay đổi thông tin</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<link href="css/style.css" rel="stylesheet">
<link href="css/register.css" rel="stylesheet">
</head>

<body>

<jsp:include page="Header.jsp" />

<%
    Users user = (Users) session.getAttribute("user");

    if (user == null) {
%>
    <div class="container mt-5">
        <div class="alert alert-danger text-center">
            Bạn chưa đăng nhập. Vui lòng đăng nhập trước!
        </div>
    </div>

<%
    } else {
        String hovaten = user.getFullname();
        String email = user.getEmail();
        Date ngaysinh = user.getBirth();
%>

<div class="main-content">
    <div class="auth-card">
        <h3 class="auth-title">Thay đổi thông tin</h3>

        <form action="doi-thong-tin" method="post">

            <div class="mb-3">
                <label class="form-label">Họ và tên</label>
                <input type="text" class="form-control" name="fullname"
                       value="<%= hovaten %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email"
                       value="<%= email %>">
            </div>

            <div class="mb-4">
                <label class="form-label">Ngày sinh</label>
                <input type="date" class="form-control" name="birth"
                       value="<%= ngaysinh %>">
            </div>

            <button type="submit" class="btn btn-register w-100">
                <i class="fas fa-save me-2"></i>
                LƯU THAY ĐỔI
            </button>
        </form>
    </div>
</div>

<%
    }
%>

<jsp:include page="Footer.jsp" />

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
