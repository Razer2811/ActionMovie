<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Tài Khoản - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

<jsp:include page="HeaderAdmin.jsp" />

<div class="container mt-4">
    <h2 class="text-warning mb-4">QUẢN LÝ TÀI KHOẢN</h2>

    <!-- MESSAGE -->
    <c:if test="${not empty message}">
        <div class="alert alert-success alert-dismissible fade show">
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>

    <!-- ERROR -->
    <c:if test="${not empty error}">
        <div class="alert alert-danger alert-dismissible fade show">
            ${error}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>

    <!-- EDIT USER -->
    <c:if test="${not empty user}">
        <div class="card border-warning mb-4 shadow">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="fa-solid fa-pen-to-square"></i>
                Chỉnh sửa User: ${user.id}
            </div>
            <div class="card-body">
                <form action="QuanLyAccount" method="post">
                    <input type="hidden" name="action" value="update">

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Username (ID)</label>
                            <input type="text" name="id" class="form-control bg-light"
                                   value="${user.id}" readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Họ tên</label>
                            <input type="text" name="fullname" class="form-control"
                                   value="${user.fullname}" required>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control"
                                   value="${user.email}" required>
                        </div>

                        <div class="col-md-2 d-flex align-items-center mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       name="admin" value="true"
                                       ${user.admin ? "checked" : ""}>
                                <label class="form-check-label fw-bold">Quyền Admin</label>
                            </div>
                        </div>

                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">Lưu</button>
                        </div>

                        <div class="col-12 text-end">
                            <a href="QuanLyAccount" class="btn btn-outline-secondary btn-sm">Hủy bỏ</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </c:if>

    <!-- TABLE -->
    <div class="table-responsive">
        <table class="table table-dark table-hover table-bordered align-middle">
            <thead>
            <tr class="text-warning text-center">
                <th>Username (ID)</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Ngày sinh</th>
                <th>Ngày đăng ký</th>
                <th>Vai trò</th>
                <th>Hành động</th>
            </tr>
            </thead>

            <tbody>
            <c:choose>
                <c:when test="${not empty listUsers}">
                    <c:forEach var="u" items="${listUsers}">
                        <tr>
                            <td class="fw-bold">${u.id}</td>
                            <td>${u.fullname}</td>
                            <td>${u.email}</td>
                            <td>${u.birth}</td>
                            <td>${u.startday}</td>

                            <td class="text-center">
                                <c:choose>
                                    <c:when test="${u.admin}">
                                        <span class="badge bg-danger">Admin</span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="badge bg-secondary">User</span>
                                    </c:otherwise>
                                </c:choose>
                            </td>

                            <td class="text-center">
                                <a href="QuanLyAccount?action=delete&id=${u.id}"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Bạn có chắc muốn xóa user ${u.id}?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    </c:forEach>
                </c:when>

                <c:otherwise>
                    <tr>
                        <td colspan="7" class="text-center">Không có dữ liệu</td>
                    </tr>
                </c:otherwise>
            </c:choose>
            </tbody>
        </table>
    </div>
</div>

<jsp:include page="Footer.jsp" />

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
