package dao;

import java.sql.Date;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;

import modal.KetNoi;
import modal.Users;

public class UserDao {
	public ArrayList<Users> getUser() throws Exception {
		ArrayList<Users> ds = new ArrayList();
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "SELECT * FROM USERS WHERE active = 1";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		ResultSet rs = cmd.executeQuery();

		while (rs.next()) {
			ds.add(new Users(rs.getInt("id"), rs.getString("username"), rs.getString("pass"), rs.getString("email"),
					rs.getString("fullname"), rs.getDate("birth"), rs.getString("avatar"), rs.getDate("starday"),
					rs.getBoolean("vip"), rs.getBoolean("admin"), rs.getBoolean("active")));
		}
		rs.close();
		kn.cn.close();
		return ds;
	}

	public Users ktdangnhap(String ten, String mk) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "SELECT * FROM USERS WHERE username LIKE ? AND pass LIKE ?";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setString(1, ten);
		cmd.setString(2, mk);
		ResultSet rs = cmd.executeQuery();
		Users us = null;
		if (rs.next()) {
			int id = rs.getInt("id");
			String username = rs.getString("username");
			String pass = rs.getString("pass");
			String email = rs.getString("email");
			String fullname = rs.getString("fullname");
			Date birth = rs.getDate("birth");
			String avatar = rs.getString("avatar");
			Date starday = rs.getDate("starday");
			boolean vip = rs.getBoolean("vip");
			boolean admin = rs.getBoolean("admin");
			boolean active = rs.getBoolean("active");
			us = new Users(id, username, pass, email, fullname, birth, avatar, starday, vip, admin, active);
		}
		rs.close();
		kn.cn.close();
		return us;
	}

	public boolean checkTaiKhoanTonTai(String tendn) throws Exception {
	    KetNoi kn = new KetNoi();
	    kn.ketnoi();
	    String sql = "SELECT * FROM USERS WHERE username = ?";
	    PreparedStatement cmd = kn.cn.prepareStatement(sql);
	    cmd.setString(1, tendn);
	    ResultSet rs = cmd.executeQuery();
	    boolean exists = rs.next(); 

	    rs.close();
	    cmd.close();
	    kn.cn.close();
	    
	    return exists;
	}

	public void themUser(String username, String pass, String email, String fullname, Date birth, String avatar,
			Date starday) throws Exception {

		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "INSERT INTO USERS(username, pass, email, fullname, birth, avatar, starday, vip, admin, active) VALUES(?, ?, ?, ?, ?, ?, ?, 0, 0, 1)";

		PreparedStatement cmd = kn.cn.prepareStatement(sql);

		// Set dữ liệu (Giữ nguyên thứ tự)
		cmd.setString(1, username);
		cmd.setString(2, pass);
		cmd.setString(3, email);
		cmd.setString(4, fullname);
		cmd.setDate(5, birth);
		cmd.setString(6, avatar);
		cmd.setDate(7, starday);

		cmd.executeUpdate();
		kn.cn.close();
	}

	public void capNhatMatKhau(int id, String mkmoi) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "UPDATE USERS SET pass = ? WHERE id = ?";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setString(1, mkmoi);
		cmd.setLong(2, id);
		cmd.executeUpdate();
