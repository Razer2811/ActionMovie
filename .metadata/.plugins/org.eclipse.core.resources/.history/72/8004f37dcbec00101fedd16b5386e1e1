	public void delete(int id) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "DELETE FROM USERS WHERE id = ?";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setInt(1, id);
		cmd.executeUpdate();
		kn.cn.close();
	}
	// 1. Hàm tìm User theo ID (Dùng để hiển thị lên form sửa)
    public Users findById(int id) throws Exception {
        KetNoi kn = new KetNoi();
        kn.ketnoi();
        String sql = "SELECT * FROM USERS WHERE id = ?";
        PreparedStatement cmd = kn.cn.prepareStatement(sql);
        cmd.setInt(1, id); // SQL Server/MySQL tự ép kiểu String về Int
        ResultSet rs = cmd.executeQuery();
        Users us = null;
        if (rs.next()) {
            // Copy y nguyên cách map dữ liệu của hàm ktdangnhap
            us = new Users(
                rs.getInt("id"), 
                rs.getString("username"), 
                rs.getString("pass"), 
                rs.getString("email"),
                rs.getString("fullname"), 
                rs.getDate("birth"), 
                rs.getString("avatar"), 
                rs.getDate("starday"),
                rs.getBoolean("vip"), 
                rs.getBoolean("admin"), 
                rs.getBoolean("active")
            );
        }
        rs.close();
        kn.cn.close();
        return us;
    }

    public int update(Users u) {
        int ketQua = 0;
        try {
            // Bước 1: Tạo kết nối đến CSDL
            KetNoi kn = new KetNoi();
            kn.ketnoi();

            // Bước 2: Tạo ra đối tượng statement
            // Cập nhật các trường thông tin cá nhân dựa trên cấu trúc bảng USERS của bạn
            String sql = "UPDATE USERS " 
                       + " SET fullname=?" 
                       + ", email=?" 
                       + ", birth=?" 
                       + ", avatar=?" 
                       + ", vip=?" 
                       + ", admin=?" 
                       + ", active=?" 
                       + " WHERE id=?";

            PreparedStatement st = kn.cn.prepareStatement(sql);
            
            // Bước 3: Điền dữ liệu vào các dấu hỏi (?)
            st.setString(1, u.getFullname());
            st.setString(2, u.getEmail());
            st.setDate(3, (Date) u.getBirth());
            st.setString(4, u.getAvatar());
            st.setBoolean(5, u.isVip());
            st.setBoolean(6, u.isAdmin());
            st.setBoolean(7, u.isActive());
            st.setInt(8, u.getId()); // Điều kiện WHERE id=?

            // Bước 4: Thực thi câu lệnh SQL
            System.out.println("Đang thực thi: " + sql);
            ketQua = st.executeUpdate();

            System.out.println("Có " + ketQua + " dòng bị thay đổi!");

            // Bước 5: Đóng kết nối
            kn.cn.close();
        } catch (Exception e) {
            e.printStackTrace();
        }

        return ketQua;
    }
    public boolean changePassword(Users u) {
        int ketQua = 0;
        try {
            KetNoi kn = new KetNoi();
            kn.ketnoi();
            // Bước 2: tạo ra đối tượng statement
            // Lưu ý: bảng của bạn là USERS và cột là pass, id
            String sql = "UPDATE USERS SET pass=? WHERE id=?";
            PreparedStatement st = kn.cn.prepareStatement(sql);
            st.setString(1, u.getPass()); 
            st.setInt(2, u.getId()); 

            System.out.println(sql);
            ketQua = st.executeUpdate();

            System.out.println("Bạn đã thực thi: " + sql);
            System.out.println("Có " + ketQua + " dòng bị thay đổi!");

            kn.cn.close();
        } catch (Exception e) {
            e.printStackTrace();
        }

        return ketQua > 0;
    }
    
