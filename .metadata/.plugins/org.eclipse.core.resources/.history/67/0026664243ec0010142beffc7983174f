package controller;

import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import com.google.gson.Gson;
import modal.ChatMessage;

@WebServlet("/Chatbot")
public class ChatbotServlet extends HttpServlet {
    private static final long serialVersionUID = 1L;
    private Gson gson = new Gson();

    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        
        request.setCharacterEncoding("UTF-8");
        response.setCharacterEncoding("UTF-8");
        response.setContentType("application/json; charset=UTF-8");
        
        String message = request.getParameter("message");
        String answer = processQuestion(message);
        
        ChatMessage chatMessage = new ChatMessage(message, answer);
        String jsonResponse = gson.toJson(chatMessage);
        
        PrintWriter out = response.getWriter();
        out.print(jsonResponse);
        out.flush();
        out.close();
    }
    
    private String processQuestion(String question) {
        if (question == null || question.trim().isEmpty()) {
            return "Vui lòng nhập câu hỏi!";
        }
        
        question = question.toLowerCase().trim();
        
        if (question.contains("phim mới") || question.contains("cập nhật")) {
            return "🎬 Hãy xem mục 'Phim Mới Cập Nhật' trên trang chủ để khám phá những bộ phim mới nhất!";
        }
        
        if (question.contains("thịnh hành") || question.contains("hot") || question.contains("trending")) {
            return "🔥 Xem mục 'Phim Đang Thịnh Hành' để tìm những bộ phim được xem nhiều nhất!";
        }
        
        if (question.contains("tìm") || question.contains("search") || question.contains("kiếm")) {
            return "🔍 Bạn có thể tìm phim bằng thanh tìm kiếm ở header. Nhập tên phim và nhấn Enter!";
        }
        
        if (question.contains("yêu thích") || question.contains("like") || question.contains("thích")) {
            return "❤️ Click vào nút ❤️ ở trang chi tiết phim để thêm vào danh sách yêu thích. Xem lại ở mục 'Phim Yêu Thích'!";
        }
        
        if (question.contains("chia sẻ") || question.contains("share")) {
            return "📤 Click nút 'Chia Sẻ' ở trang chi tiết phim để chia sẻ với bạn bè!";
        }
        
        if (question.contains("đăng nhập") || question.contains("login")) {
            return "🔐 Click vào nút 'Đăng Nhập' ở góc trên phải header để đăng nhập tài khoản!";
        }
        
        if (question.contains("đăng ký") || question.contains("register")) {
            return "📝 Click vào nút 'Đăng Ký' ở góc trên phải header để tạo tài khoản mới!";
        }
        
        if (question.contains("thể loại") || question.contains("genre") || question.contains("category")) {
            return "🎭 Click vào 'Thể Loại' ở header để lọc phim theo thể loại yêu thích!";
        }
        
        if (question.contains("quản lý") || question.contains("admin")) {
            return "⚙️ Nếu bạn là admin, bạn có thể vào 'Quản Lý Phim' để thêm, sửa hoặc xóa phim!";
        }
        
        if (question.contains("giá") || question.contains("price") || question.contains("cost")) {
            return "💰 Giá phim tùy thuộc vào chất lượng và nội dung. Xem chi tiết ở trang từng bộ phim!";
        }
        
        if (question.contains("chất lượng") || question.contains("quality")) {
            return "📺 Phim có sẵn ở các chất lượng: HD, FHD, 4K. Chọn chất lượng phù hợp với bạn!";
        }
        
        return "❓ Xin lỗi, tôi không hiểu câu hỏi của bạn. Bạn có thể hỏi về: phim mới, phim hot, tìm phim, yêu thích, chia sẻ, đăng nhập, đăng ký, thể loại, v.v.";
    }
}