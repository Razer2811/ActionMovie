package controller;

import java.io.IOException;
import java.util.List;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import dao.UserDao;
import modal.Users;

@WebServlet("/QuanLyAccount")
public class QuanLyAccountController extends HttpServlet {
    private static final long serialVersionUID = 1L;

    protected void doGet(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        try {
            request.setCharacterEncoding("utf-8");
            response.setCharacterEncoding("utf-8");

            // 1. Kiểm tra quyền Admin
            HttpSession session = request.getSession();
            Users admin = (Users) session.getAttribute("user");
            if (admin == null || !admin.isAdmin()) {
                response.sendRedirect("Home"); 
                return;
            }

            UserDao dao = new UserDao();
            String action = request.getParameter("action");
            String id = request.getParameter("id");

            // 2. Xử lý các hành động GET (Delete, Edit)
            if (action != null) {
                if (action.equals("delete") && id != null) {
                    // Không cho tự xóa chính mình
                    if (!id.equals(admin.getId())) {
                        dao.delete(id);
                        request.setAttribute("message", "Đã xóa tài khoản " + id);
                    } else {
                        request.setAttribute("error", "Không thể xóa tài khoản đang đăng nhập!");
                    }
                } else if (action.equals("edit") && id != null) {
                    // Lấy thông tin user cần sửa để đổ lên form
                    Users userToEdit = dao.findById(id); // Cần thêm hàm này trong DAO
                    request.setAttribute("user", userToEdit);
                }
            }

            // 3. Load danh sách và forward
            List<Users> listUsers = dao.getUser();
            request.setAttribute("listUsers", listUsers);
            request.getRequestDispatcher("Account.jsp").forward(request, response);

        } catch (Exception e) {
            e.printStackTrace();
            response.sendRedirect("Home");
        }
    }

    protected void doPost(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        try {
            request.setCharacterEncoding("utf-8");
            response.setCharacterEncoding("utf-8");
            
            UserDao dao = new UserDao();
            String action = request.getParameter("action");
            
            // 4. Xử lý hành động Update từ Form
            if ("update".equals(action)) {
                String id = request.getParameter("id");
                String fullname = request.getParameter("fullname");
                String email = request.getParameter("email");
                boolean isAdmin = request.getParameter("admin") != null; // Checkbox trả về null nếu không tick
                
                // Tạo object mới (Giữ nguyên password cũ hoặc xử lý riêng)
                // Lưu ý: Hàm update trong DAO cần xử lý việc giữ nguyên pass nếu không đổi
                Users u = new Users();
                u.setId(id);
                u.setFullname(fullname);
                u.setEmail(email);
                u.setAdmin(isAdmin);
                
                dao.update(u); // Cần thêm hàm này trong DAO
                request.setAttribute("message", "Cập nhật thành công user: " + id);
            }
            
            // Sau khi update xong, load lại danh sách
            doGet(request, response);
            
        } catch (Exception e) {
            e.printStackTrace();
            request.setAttribute("error", "Lỗi cập nhật: " + e.getMessage());
            doGet(request, response);
        }
    }
}