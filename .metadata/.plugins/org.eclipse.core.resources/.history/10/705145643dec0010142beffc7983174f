package controller;

import java.io.File;
import java.io.IOException;
import java.util.List;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.apache.commons.fileupload.FileItem;
import org.apache.commons.fileupload.disk.DiskFileItemFactory;
import org.apache.commons.fileupload.servlet.ServletFileUpload;

import dao.GenreVideoDao;
import dao.VideoDao;
import modal.Users;
import modal.Video;

@WebServlet("/Addvideo")
public class AddVideoController extends HttpServlet {
    private static final long serialVersionUID = 1L;

    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        try {
            // Check Admin
            HttpSession session = request.getSession();
            Users user = (Users) session.getAttribute("user");
            if (user == null || !user.isAdmin()) {
                response.sendRedirect("Home"); 
                return;
            }

            // Lấy danh sách thể loại và forward sang JSP
            request.setAttribute("listgenre", new GenreVideoDao().getGenreVideo());
            request.getRequestDispatcher("AddVideo.jsp").forward(request, response);
            
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        request.setCharacterEncoding("UTF-8");
        response.setCharacterEncoding("UTF-8");

        try {
            // 1. Kiểm tra Multipart
            if (!ServletFileUpload.isMultipartContent(request)) {
                doGet(request, response);
                return;
            }

            // 2. Cấu hình thư mục lưu file (Lưu vào thư mục "img" của dự án)
            String uploadFolder = request.getServletContext().getRealPath("/img");
            File dir = new File(uploadFolder);
            if (!dir.exists()) dir.mkdirs();

            // 3. Khởi tạo biến hứng dữ liệu
            String title = "", link = "", quality = "HD", descriptions = "";
            String posterName = "default.jpg"; // Ảnh mặc định
            int times = 0;
            int genreId = 1;
            boolean active = false; // Mặc định ẩn
            boolean vip = false;

            // 4. Xử lý Upload
            DiskFileItemFactory factory = new DiskFileItemFactory();
            ServletFileUpload upload = new ServletFileUpload(factory);
            upload.setHeaderEncoding("UTF-8"); // Xử lý tên file tiếng Việt
            
            List<FileItem> items = upload.parseRequest(request);

            for (FileItem item : items) {
                if (!item.isFormField()) {
                    // --- XỬ LÝ FILE ẢNH ---
                    String fileName = item.getName();
                    if (fileName != null && !fileName.trim().isEmpty()) {
                        // Lấy tên file gốc
                        fileName = new File(fileName).getName();
                        posterName = fileName;

                        // Lưu file vào server
                        File storeFile = new File(uploadFolder + File.separator + fileName);
                        item.write(storeFile);
                    }
                } else {
                    // --- XỬ LÝ TEXT INPUT ---
                    String fieldName = item.getFieldName();
                    String fieldValue = item.getString("UTF-8");

                    switch (fieldName) {
                        case "title": title = fieldValue; break;
                        case "link": link = fieldValue; break;
                        case "quality": quality = fieldValue; break;
                        case "descriptions": descriptions = fieldValue; break;
                        
                        case "times":
                            if(!fieldValue.isEmpty()) times = Integer.parseInt(fieldValue);
                            break;
                        case "genreid":
                            if(!fieldValue.isEmpty()) genreId = Integer.parseInt(fieldValue);
                            break;
                            
                        // Checkbox: nếu có gửi lên nghĩa là true
                        case "active": active = true; break;
                        case "vip": vip = true; break;
                    }
                }
            }

            // 5. Kiểm tra dữ liệu bắt buộc
            if (title.isEmpty() || title.length() > 255) {
                request.setAttribute("message", "Tên phim phải 1-255 ký tự!");
                return;
            }
            if (!link.matches("^(https?|ftp)://.*")) {
                request.setAttribute("message", "Link phải là URL hợp lệ!");
                return;
            }

            // 6. Lưu vào DB
            Video v = new Video();
            v.setTitle(title);
            v.setLink(link);
            v.setPoster(posterName); // Lưu tên file (ví dụ: phim.jpg)
            v.setTimes(times);
            v.setQuality(quality);
            v.setDescriptions(descriptions);
            v.setActive(active);
            v.setVip(vip);
            v.setIdgenre(genreId);
            v.setViews(0);

            VideoDao dao = new VideoDao();
            dao.themVideo(v);

            request.setAttribute("message", "Thêm phim [" + title + "] thành công!");
            
            // Reload trang để nhập tiếp
            doGet(request, response);

        } catch (Exception e) {
            e.printStackTrace();
            request.setAttribute("message", "Lỗi hệ thống: " + e.getMessage());
            doGet(request, response);
        }
    }
}