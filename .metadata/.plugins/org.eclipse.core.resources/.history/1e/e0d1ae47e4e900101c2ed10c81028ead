package controller;

import java.io.IOException;
import java.util.ArrayList;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import dao.GenreVideoDao;
import dao.VideoDao;
import modal.GenreVideo;
import modal.Video;

@WebServlet("/QuanLyPhim")
public class QuanLyPhimController extends HttpServlet {
    private static final long serialVersionUID = 1L;

    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        try {
            request.setCharacterEncoding("utf-8");
            response.setCharacterEncoding("utf-8");

            VideoDao videoDao = new VideoDao();
            GenreVideoDao genreDao = new GenreVideoDao();
            
            // --- BƯỚC 1: QUAN TRỌNG NHẤT CHO HEADER ---
            // Luôn lấy danh sách thể loại để Header.jsp có dữ liệu hiển thị sub-menu
            ArrayList<GenreVideo> listGenre = genreDao.getGenreVideo(); 
            request.setAttribute("dsGenre", listGenre); 

            // --- BƯỚC 2: LẤY THAM SỐ TỪ FORM TÌM KIẾM ---
            String searchKey = request.getParameter("searchfilm"); 
            String genreIdStr = request.getParameter("genre");

            String keyword = (searchKey != null) ? searchKey.trim() : "";
            int genreId = -1;

            // --- BƯỚC 3: XỬ LÝ LOGIC CHỌN THỂ LOẠI MẶC ĐỊNH (KHÔNG CÓ "TẤT CẢ") ---
            if (genreIdStr != null) {
                genreId = Integer.parseInt(genreIdStr);
            } else if (listGenre != null && !listGenre.isEmpty()) {
                // Nếu lần đầu vào trang, mặc định lấy thể loại đầu tiên trong list
                genreId = listGenre.get(0).getId();
            }
           
            // --- BƯỚC 4: LỌC DANH SÁCH VIDEO ---
            ArrayList<Video> allVideos = videoDao.getVideo(); 
            ArrayList<Video> resultList = new ArrayList<>();

            if (allVideos != null) {
                for (Video v : allVideos) {
                    // Lọc theo genreId đã xác định ở trên và keyword tìm kiếm
                    boolean matchGenre = (v.getIdgenre() == genreId);
                    boolean matchName = keyword.isEmpty() || v.getTitle().toLowerCase().contains(keyword.toLowerCase());

                    if (matchGenre && matchName) {
                        resultList.add(v);
                    }
                }
            }

            // --- BƯỚC 5: ĐẨY DỮ LIỆU SANG JSP ---
            request.setAttribute("dsvideo", resultList);
            request.setAttribute("check", genreId); // Để Select-box đánh dấu đúng loại
            request.setAttribute("name", keyword);  // Để ô tìm kiếm giữ lại chữ

            request.getRequestDispatcher("QuanLyPhim.jsp").forward(request, response);

        } catch (Exception e) {
            e.printStackTrace();
            request.getRequestDispatcher("QuanLyPhim.jsp").forward(request, response);
        }
    }

    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        doGet(request, response);
    }
}