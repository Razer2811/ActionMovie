	// 11. Tăng lượt xem (Update View)
	public void updateView(int id) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "UPDATE VIDEO SET views = views + 1 WHERE id = ?";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setInt(1, id);
		cmd.executeUpdate();
		cmd.close();
		kn.cn.close();
	}

