	// 6. Thêm Video mới
	public int themVideo(Video v) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "INSERT INTO VIDEO (title, poster, views, link, descriptions, active, vip, quality, dayupload, times, idgenre) VALUES (?,?,?,?,?,?,?,?,GETDATE(),?,?)";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setString(1, v.getTitle());
		cmd.setString(2, v.getPoster());
		cmd.setInt(3, 0);
		cmd.setString(4, v.getLink());
		cmd.setString(5, v.getDescriptions());
		cmd.setBoolean(6, v.getVip());
		cmd.setString(7, v.getQuality());
		cmd.setInt(8, v.getTimes());
		cmd.setInt(9, v.getIdgenre());
		int kq = cmd.executeUpdate();
		kn.cn.close();
		return kq;
	}

	// 7. Xóa Video
	public void xoaVideo(String mavideo) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "DELETE FROM VIDEO WHERE id = ?";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setInt(1, Integer.parseInt(mavideo));
		cmd.executeUpdate();
		kn.cn.close();
	}

