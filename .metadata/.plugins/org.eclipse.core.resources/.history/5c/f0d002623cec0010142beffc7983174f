 // 15. Lấy danh sách video đã ẩn (active = 0)
    public ArrayList<Video> getVideoUnActive() throws Exception {
        ArrayList<Video> ds = new ArrayList<>();
        KetNoi kn = new KetNoi();
        kn.ketnoi();
        
        String sql = "SELECT * FROM VIDEO WHERE active = 0 ORDER BY id DESC";
        PreparedStatement cmd = kn.cn.prepareStatement(sql);
        ResultSet rs = cmd.executeQuery();

        while (rs.next()) {
            int videoid = rs.getInt("id");
            Video v = new Video(videoid, rs.getString("title"), rs.getString("poster"), rs.getInt("views"),
                    rs.getString("link"), rs.getString("descriptions"), rs.getBoolean("active"), rs.getBoolean("vip"),
                    rs.getString("quality"), rs.getDate("dayupload"), rs.getInt("times"), rs.getInt("idgenre"));

            // Gán thêm thông tin tương tác
            v.setTotalFavorites(getTotalFavorites(videoid));
            v.setTotalShares(getTotalShares(videoid));

            ds.add(v);
        }
        rs.close();
        kn.cn.close();
        return ds;
    }

    // 16. Ẩn Video (Thay vì xóa hẳn khỏi DB)
    public void unActiveVideo(int id) throws Exception {
        KetNoi kn = new KetNoi();
        kn.ketnoi();
        String sql = "UPDATE VIDEO SET active = 0 WHERE id = ?";
        PreparedStatement cmd = kn.cn.prepareStatement(sql);
        cmd.setInt(1, id);
        cmd.executeUpdate();
        kn.cn.close();
    }

    // 17. Khôi phục Video đã ẩn
    public void restoreVideo(int id) throws Exception {
        KetNoi kn = new KetNoi();
        kn.ketnoi();
        String sql = "UPDATE VIDEO SET active = 1 WHERE id = ?";
        PreparedStatement cmd = kn.cn.prepareStatement(sql);
        cmd.setInt(1, id);
        cmd.executeUpdate();
        kn.cn.close();
    }
