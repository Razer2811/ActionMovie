public class VideoDao {

	// 1. Lấy tổng lượt thích
	public int getTotalFavorites(int videoid) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "SELECT COUNT(*) as total FROM FAVORITE WHERE videoid = ? AND active = 1";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setInt(1, videoid);
		ResultSet rs = cmd.executeQuery();

		int total = 0;
		if (rs.next()) {
			total = rs.getInt("total");
		}
		rs.close();
		kn.cn.close();
		return total;
	}

	// 2. Lấy tổng lượt chia sẻ
	public int getTotalShares(int videoid) throws Exception {
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "SELECT COUNT(*) as total FROM SHARE WHERE videoid = ?";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		cmd.setInt(1, videoid);
		ResultSet rs = cmd.executeQuery();

		int total = 0;
		if (rs.next()) {
			total = rs.getInt("total");
		}
		rs.close();
		kn.cn.close();
		return total;
	}

	// 3. Lấy tất cả video
	public ArrayList<Video> getVideo() throws Exception {
		ArrayList<Video> ds = new ArrayList<>();
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "SELECT * FROM VIDEO WHERE active = 1";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		ResultSet rs = cmd.executeQuery();

		while (rs.next()) {
			int videoid = rs.getInt("id");
			Video v = new Video(videoid, rs.getString("title"), rs.getString("poster"), rs.getInt("views"),
					rs.getString("link"), rs.getString("descriptions"), rs.getBoolean("active"), rs.getBoolean("vip"),
					rs.getString("quality"), rs.getDate("dayupload"), rs.getInt("times"), rs.getInt("idgenre"));

			v.setTotalFavorites(getTotalFavorites(videoid));
			v.setTotalShares(getTotalShares(videoid));

			ds.add(v);
		}

		rs.close();
		kn.cn.close();
		return ds;
	}

	// 4. Tìm kiếm theo tên
	public ArrayList<Video> timTen(String key) throws Exception {
		ArrayList<Video> ds = new ArrayList<>();
		KetNoi kn = new KetNoi();
		kn.ketnoi();
		String sql = "select * from VIDEO where title LIKE ? AND active = 1";
		PreparedStatement cmd = kn.cn.prepareStatement(sql);
		String tukhoa = "%" + key + "%";
		cmd.setString(1, tukhoa);

		ResultSet rs = cmd.executeQuery();
		while (rs.next()) {
			int videoid = rs.getInt("id");
			Video v = new Video(videoid, rs.getString("title"), rs.getString("poster"), rs.getInt("views"),
					rs.getString("link"), rs.getString("descriptions"), rs.getBoolean("active"), rs.getBoolean("vip"),
					rs.getString("quality"), rs.getDate("dayupload"), rs.getInt("times"), rs.getInt("idgenre"));

			v.setTotalFavorites(getTotalFavorites(videoid));
			v.setTotalShares(getTotalShares(videoid));

			ds.add(v);
		}
		rs.close();
		kn.cn.close();

		return ds;
	}

