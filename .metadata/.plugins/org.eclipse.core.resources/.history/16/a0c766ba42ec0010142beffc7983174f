.chatbot-box {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 350px;
    height: 450px;
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    z-index: 9999;
    transition: bottom 0.3s ease;
}

.chatbot-header {
    background-color: #d2a106;
    color: #000;
    padding: 15px;
    border-radius: 12px 12px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 16px;
}

.chatbot-close-btn {
    background: none;
    border: none;
    color: #000;
    font-size: 18px;
    cursor: pointer;
    font-weight: bold;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chatbot-close-btn:hover {
    opacity: 0.8;
}

.chatbot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chatbot-messages::-webkit-scrollbar {
    width: 6px;
}

.chatbot-messages::-webkit-scrollbar-track {
    background: #0d1117;
}

.chatbot-messages::-webkit-scrollbar-thumb {
    background: #30363d;
    border-radius: 3px;
}

.chatbot-message {
    display: flex;
    animation: slideIn 0.3s ease;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.chatbot-message.user-msg {
    justify-content: flex-end;
}

.chatbot-message.user-msg p {
    background-color: #d2a106;
    color: #000;
    padding: 10px 14px;
    border-radius: 12px 12px 2px 12px;
    max-width: 80%;
    word-wrap: break-word;
    margin: 0;
    font-size: 14px;
}

.chatbot-message.bot-msg {
    justify-content: flex-start;
}

.chatbot-message.bot-msg p {
    background-color: #30363d;
    color: #e6edf3;
    padding: 10px 14px;
    border-radius: 12px 12px 12px 2px;
    max-width: 80%;
    word-wrap: break-word;
    margin: 0;
    font-size: 14px;
}

.chatbot-footer {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #30363d;
}

.chatbot-input {
    flex: 1;
    background-color: #0d1117;
    border: 1px solid #30363d;
    color: #e6edf3;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 14px;
    font-family: 'Segoe UI', sans-serif;
}

.chatbot-input:focus {
    border-color: #d2a106;
    outline: none;
    box-shadow: 0 0 0 2px rgba(210, 161, 6, 0.2);
}

.chatbot-input::placeholder {
    color: #8b949e;
}

.chatbot-send-btn {
    background-color: #d2a106;
    color: #000;
    border: none;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
}

.chatbot-send-btn:hover {
    background-color: #b08800;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(210, 161, 6, 0.3);
}

.chatbot-send-btn:active {
    transform: translateY(0);
}

@media (max-width: 768px) {
    .chatbot-box {
        width: 300px;
        height: 400px;
        bottom: 10px;
        right: 10px;
    }
    
    .chatbot-message.user-msg p,
    .chatbot-message.bot-msg p {
        max-width: 85%;
    }
}