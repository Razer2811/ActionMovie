<%@page import="modal.GenreVideo"%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.ArrayList"%>
<%@ page import="modal.Video"%>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Phim - Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
    <link href="css/home.css" rel="stylesheet">
</head>
<body>
	<%
		ArrayList<GenreVideo> dsLoai = (ArrayList<GenreVideo>)request.getAttribute("dsGenre");
		ArrayList<Video> dsvideo = (ArrayList<Video>)request.getAttribute("dsvideo");
		Integer check = (Integer) request.getAttribute("check");
		String name = (String) request.getAttribute("name");
	    Boolean active = (Boolean) session.getAttribute("active");
		
	%>
    <jsp:include page="HeaderAdmin.jsp"></jsp:include>

    <div class="container mt-4">
        <h3 class="section-title">Quản Lý Video</h3>

        <div>
        	<form action="QuanLyPhim" method = "post">
        		<div>
        			<label>Thể loại	</label></br>
        			<select>
        				<option value = -1>Tất cả</option>
        				<%
        					if (dsLoai != null){
        						for(GenreVideo g : dsLoai){
        				%>
        					<option value="<%= g.getId() %>"
                                <%= (check != null && g.getId() == check) ? "selected" : "" %>>
                                <%= g.getTitle() %>
                            </option>
                        <%
        						}
        					}
        				%>
        			</select>
        		</div>
        		
        		<div>
                    <label>Tìm Kiếm</label><br>
                    <div style="display: flex;">
                        <input style="width: 65%;" type="search"
                               name="searchfilm" class="form-control">
                        <button class="btn btn-dark">Tìm Kiếm</button>
                    </div>
                </div>
                <div>
                    <label>Phim</label><br>
                    <a href="UnActive" class="btn btn-light">
                        Phim Đã Ẩn <i class='bx bx-hide'></i>
                    </a>
                </div>
                <div>
                    <label>Phim</label><br>
                    <a href="Active" class="btn btn-light">
                        Phim Hiện Hành <i class='bx bx-film'></i>
                    </a>
                </div>
                <div>
                    <label>Thêm Mới</label><br>
                    <a href="Addvideo?action=new" class="btn btn-success">
                        Thêm Phim Mới <i class='bx bxs-folder-plus'></i>
                    </a>
                </div>
        	</form>
        	<div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-4">
            <%

                if (dsvideo != null && dsvideo.size() > 0) {
                    for (Video video : dsvideo) {
            %>
            <div class="col">
                <div class="card-film">
                    <a href="DetailMovie?id=<%=video.getId()%>" class="poster-wrapper d-block">
                        <img src="img/<%=video.getPoster()%>" alt="<%=video.getTitle()%>">
                        <div class="hover-overlay">
                            <i class='bx bx-play-circle'></i>
                        </div>
                    </a>

                    <div class="card-body-custom">
                        <a href="DetailMovie?id=<%=video.getId()%>" 
                           class="movie-title" 
                           title="<%=video.getTitle()%>">
                           <%=video.getTitle()%>
                        </a>

                        <div class="movie-meta">
                            <div class="meta-item">
                                <i class='bx bxs-show'></i> 
                                <span><%=video.getViews()%></span>
                            </div>
                            <div class="meta-item">
                                <i class='bx bxs-heart'></i> 
                                <span><%=video.getTotalFavorites()%></span>
                            </div>
                            <div class="meta-item">
                                <i class='bx bxs-share'></i> 
                                <span><%=video.getTotalShares()%></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%
                    }
                } else {
            %>
                <div class="col-12">
                    <div class="alert alert-dark text-center border-secondary" style="background: #161b22; color: #8b949e;">
                        Hiện chưa có phim nào trong danh sách.
                    </div>
                </div>
            <%
                }
            %>
        </div>
        </div>
        <%
            Integer totalPagesObj = (Integer) request.getAttribute("totalPages");
            Integer currentPageObj = (Integer) request.getAttribute("currentPage");
            int totalPages = (totalPagesObj != null) ? totalPagesObj : 1;
            int currentPage = (currentPageObj != null) ? currentPageObj : 1;
            if (totalPages > 1) {
        %>
        <div class="d-flex justify-content-center mt-5 mb-5">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-lg">
                    <li class="page-item <%=(currentPage == 1) ? "disabled" : ""%>">
                        <a class="page-link" href="Home?page=<%=currentPage - 1%>" aria-label="Previous">
                            <i class='bx bx-chevron-left'></i>
                        </a>
                    </li>

                    <% for (int i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%=(i == currentPage) ? "active" : ""%>">
                            <a class="page-link" href="Home?page=<%=i%>"><%=i%></a>
                        </li>
                    <% } %>

                    <li class="page-item <%=(currentPage == totalPages) ? "disabled" : ""%>">
                        <a class="page-link" href="Home?page=<%=currentPage + 1%>" aria-label="Next">
                            <i class='bx bx-chevron-right'></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        <% } %>
    </div> <jsp:include page="Footer.jsp"></jsp:include>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>