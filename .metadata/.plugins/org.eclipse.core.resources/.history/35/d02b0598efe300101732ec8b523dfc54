/* MENU CHA */
.main-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex; /* Đảm bảo menu chính nằm ngang */
    align-items: center;
}

.main-menu > ul > li {
    position: relative;
    display: inline-block;
}

/* MENU CON – PHỐI MÀU DARK THEME */
.sub-menu {
    position: absolute;
    top: 100%;
    left: 0;

    background-color: #242424; /* Màu xám đậm trùm với Header */
    min-width: 200px;
    border-radius: 8px; /* Bo góc hiện đại */
    border: 1px solid #30363d; /* Viền mờ giống phong cách GitHub */
    box-shadow: 0 8px 24px rgba(0,0,0,0.5); /* Đổ bóng sâu tạo độ nổi */

    /* HIỆU ỨNG MƯỢT MÀ CỦA BẠN */
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease;

    display: flex;
    flex-direction: column;   /* Xếp dọc các thể loại */
    padding: 8px 0;
    margin-top: 5px; /* Tạo khoảng cách nhỏ với header */

    z-index: 999;
}

/* HOVER HIỆN MENU */
.main-menu li:hover > .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

/* ITEM MENU CON */
.sub-menu li {
    width: 100%;
}

.sub-menu li a {
    display: block;
    padding: 10px 16px;
    color: #e6edf3; /* Màu trắng xám (không bị chói) */
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    transition: all 0.2s;
}

/* MÀU HOVER VÀNG KIM LOẠI */
.sub-menu li a:hover {
    background-color: #30363d; /* Nền xám sáng hơn một chút */
    color: #d2a106; /* Chữ chuyển sang màu vàng đặc trưng của bạn */
    padding-left: 20px; /* Hiệu ứng đẩy nhẹ sang phải khi hover */
}