<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý Phim - Admin</title>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

<link href="css/style.css" rel="stylesheet">
<link href="css/home.css" rel="stylesheet">
<link href="css/card.css" rel="stylesheet">

<style>
/* ===== (GIỮ NGUYÊN CSS CỦA BẠN – KHÔNG ĐỤNG) ===== */
body{background:#0d1117;color:#e6edf3;font-family:'Segoe UI',sans-serif;}
.section-title{color:#d2a106;font-weight:700;border-left:5px solid #d2a106;padding-left:15px;margin-bottom:25px;text-transform:uppercase}
.control-panel{background:#161b22;padding:20px;border-radius:12px;border:1px solid #30363d;margin-bottom:30px}
.form-control,.form-select{background:#0d1117;border:1px solid #30363d;color:#e6edf3}
.form-control:focus,.form-select:focus{border-color:#d2a106;box-shadow:0 0 0 .25rem rgba(210,161,6,.25)}
.card-film{background:#161b22;border:1px solid #30363d;border-radius:12px;overflow:hidden;height:100%;display:flex;flex-direction:column}
.poster-wrapper{aspect-ratio:2/3;overflow:hidden}
.poster-wrapper img{width:100%;height:100%;object-fit:cover}
.hover-overlay{position:absolute;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;opacity:0}
.card-film:hover .hover-overlay{opacity:1}
.card-body-custom{padding:15px;display:flex;flex-direction:column;flex-grow:1}
.movie-title{font-size:16px;font-weight:600;color:#e6edf3;text-decoration:none;-webkit-line-clamp:2;-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;height:48px}
.movie-meta{font-size:13px;color:#8b949e;display:flex;justify-content:space-between}
.action-buttons{margin-top:auto;display:flex;gap:8px;padding-top:12px;border-top:1px solid #30363d}
.btn-custom-gold{background:#d2a106;color:#000;font-weight:600}
.btn-custom-gold:hover{background:#b08800;color:#fff}
</style>
</head>

<body>

<jsp:include page="HeaderAdmin.jsp"/>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="section-title m-0">Quản Lý Video</h3>
        <a href="Addvideo?action=new" class="btn btn-custom-gold">
            <i class='bx bxs-folder-plus'></i> Thêm Phim Mới
        </a>
    </div>

    <!-- ===== FILTER ===== -->
    <div class="control-panel">
        <form action="QuanLyPhim" method="post">
            <div class="row g-3 align-items-end">

                <!-- GENRE -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary">Thể loại</label>
                    <select class="form-select" name="genre" onchange="this.form.submit()">
                        <option value="-1">Tất Cả</option>
                        <c:forEach items="${dsGenre}" var="g">
                            <option value="${g.id}"
                                ${g.id == check ? 'selected' : ''}>
                                ${g.title}
                            </option>
                        </c:forEach>
                    </select>
                </div>

                <!-- ACTIVE / UNACTIVE -->
                <div class="col-md-5 d-flex justify-content-end gap-2">
                    <a href="QuanLyPhim"
                       class="btn ${active ? 'btn-custom-gold' : 'btn-outline-secondary'}">
                        <i class='bx bx-film'></i> Phim Hiện Hành
                    </a>

                    <a href="UnActive"
                       class="btn ${!active ? 'btn-secondary' : 'btn-outline-secondary'}">
                        <i class='bx bx-hide'></i> Phim Đã Ẩn
                    </a>
                </div>

            </div>
        </form>
    </div>

    <!-- ===== LIST VIDEO ===== -->
    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-4">

        <c:if test="${not empty dsvideo}">
            <c:forEach items="${dsvideo}" var="video">
                <div class="col">
                    <div class="card-film">

                        <a href="DetailMovie?id=${video.id}" class="poster-wrapper d-block">
                            <img src="img/${video.poster}" alt="${video.title}">
                            <div class="hover-overlay">
                                <i class='bx bx-play-circle fs-1 text-warning'></i>
                            </div>
                        </a>

                        <div class="card-body-custom">
                            <a href="DetailMovie?id=${video.id}"
                               class="movie-title"
                               title="${video.title}">
                                ${video.title}
                            </a>

                            <div class="movie-meta">
                                <span><i class='bx bxs-show'></i> ${video.views}</span>
                                <span><i class='bx bxs-heart'></i> ${video.totalFavorites}</span>
                                <span><i class='bx bxs-share'></i> ${video.totalShares}</span>
                            </div>

                            <div class="action-buttons">
                                <a href="DetailMovie?id=${video.id}" class="btn btn-sm btn-outline-light">
                                    <i class='bx bx-play-circle'></i>
                                </a>

                                <c:if test="${active}">
                                    <a href="hiddenVideo?id=${video.id}"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Ẩn phim này?');">
                                        <i class="fa-solid fa-eye-slash"></i>
                                    </a>
                                </c:if>

                                <c:if test="${!active}">
                                    <a href="restoreVideo?id=${video.id}"
                                       class="btn btn-sm btn-outline-primary"
                                       onclick="return confirm('Khôi phục phim này?');">
                                        <i class="fas fa-undo"></i>
                                    </a>
                                </c:if>
                            </div>

                        </div>
                    </div>
                </div>
            </c:forEach>
        </c:if>

        <!-- EMPTY -->
        <c:if test="${empty dsvideo}">
            <div class="col-12">
                <div class="alert alert-dark text-center py-5 border-secondary"
                     style="background:#161b22;color:#8b949e;">
                    <i class='bx bx-movie-play fs-1 mb-3 text-warning'></i><br>
                    Hiện chưa có phim nào trong danh sách này.
                </div>
            </div>
        </c:if>

    </div>

</div>

<jsp:include page="Footer.jsp"/>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
