<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>

<!-- Bubble Chat -->
<div id="chatbot-bubble" class="chatbot-bubble">
    <i class='bx bx-chat'></i>
</div>

<!-- Chat Box (ẩn lúc đầu) -->
<div id="chatbot-box" class="chatbot-box" style="display: none;">
    <div class="chatbot-header">
        <span>💬 Trợ Lý</span>
        <button id="chatbot-close" class="chatbot-close-btn">−</button>
    </div>
    
    <div id="chatbot-messages" class="chatbot-messages">
        <div class="chatbot-message bot-msg">
            <p>Xin chào! 👋 Có gì tôi có thể giúp bạn?</p>
        </div>
    </div>
    
    <div class="chatbot-footer">
        <input 
            type="text" 
            id="chatbot-input" 
            class="chatbot-input" 
            placeholder="Nhập câu hỏi..." 
            autocomplete="off"
        >
        <button id="chatbot-send-btn" class="chatbot-send-btn">Gửi</button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const bubble = document.getElementById('chatbot-bubble');
    const chatbox = document.getElementById('chatbot-box');
    const closeBtn = document.getElementById('chatbot-close');
    const sendBtn = document.getElementById('chatbot-send-btn');
    const input = document.getElementById('chatbot-input');
    const messagesDiv = document.getElementById('chatbot-messages');
    
    let isOpen = false;
    
    bubble.addEventListener('click', function() {
        if (isOpen) {
            chatbox.style.display = 'none';
            bubble.style.display = 'flex';
            isOpen = false;
        } else {
            chatbox.style.display = 'flex';
            bubble.style.display = 'none';
            isOpen = true;
            input.focus();
        }
    });
    
    closeBtn.addEventListener('click', function() {
        chatbox.style.display = 'none';
        bubble.style.display = 'flex';
        isOpen = false;
    });
    
    sendBtn.addEventListener('click', sendMessage);
    input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            sendMessage();
        }
    });
    
    function sendMessage() {
        const message = input.value.trim();
        if (!message) return;
        
        const userMsg = document.createElement('div');
        userMsg.className = 'chatbot-message user-msg';
        userMsg.innerHTML = '<p>' + escapeHtml(message) + '</p>';
        messagesDiv.appendChild(userMsg);
        
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
        
        fetch('Chatbot', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json'
            },
            body: 'message=' + encodeURIComponent(message)
        })
        .then(response => response.json())
        .then(data => {
            const botMsg = document.createElement('div');
            botMsg.className = 'chatbot-message bot-msg';
            botMsg.innerHTML = '<p>' + escapeHtml(data.answer) + '</p>';
            messagesDiv.appendChild(botMsg);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        })
        .catch(error => {
            console.error('Chatbot error:', error);
            const errorMsg = document.createElement('div');
            errorMsg.className = 'chatbot-message bot-msg';
            errorMsg.innerHTML = '<p>Có lỗi xảy ra. Vui lòng thử lại!</p>';
            messagesDiv.appendChild(errorMsg);
        });
    }
    
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
});
</script>