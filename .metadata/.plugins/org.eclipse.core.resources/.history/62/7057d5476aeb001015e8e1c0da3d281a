<%@page import="java.util.List"%>
<%@page import="modal.Users"%>
<%@page import="modal.GenreVideo"%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.ArrayList"%>
<%@ page import="modal.Video"%>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý Tài Khoản - Admin</title>
<link rel="stylesheet"
	href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css">
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
	rel="stylesheet">
<link href="css/style.css" rel="stylesheet">
<link href="css/home.css" rel="stylesheet">
<link href="css/card.css" rel="stylesheet">
</head>
<body>
	<%
        // Lấy các thông báo
        String message = (String) request.getAttribute("message");
        String error = (String) request.getAttribute("error");
        
        // Lấy đối tượng editUser (nếu đang bấm nút sửa)
        Users editUser = (Users) request.getAttribute("user");
        
        // Lấy danh sách user
        List<Users> listUsers = (List<Users>) request.getAttribute("listUsers");
    %>

	<jsp:include page="HeaderAdmin.jsp"></jsp:include>

	<div class="container mt-4">
        <h2 class="text-warning">QUẢN LÝ TÀI KHOẢN</h2>
        
        <% if (message != null && !message.isEmpty()) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>
        
        <% if (error != null && !error.isEmpty()) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% if (editUser != null) { %>
            <div class="card bg-secondary text-white mb-4">
                <div class="card-header fw-bold">Chỉnh sửa User: <%= editUser.getId() %></div>
                <div class="card-body">
                    <form action="QuanLyAccount" method="post">
                        <input type="hidden" name="action" value="update">
                        
                        <div class="row">
                            <div class="col-md-3">
                                <label>Username (ID)</label>
                                <input type="text" name="id" class="form-control" value="<%= editUser.getId() %>" readonly>
                            </div>
                            <div class="col-md-3">
                                <label>Họ tên</label>
                                <input type="text" name="fullname" class="form-control" value="<%= editUser.getFullname() %>">
                            </div>
                            <div class="col-md-3">
                                <label>Email</label>
                                <input type="email" name="email" class="form-control" value="<%= editUser.getEmail() %>">
                            </div>
                            <div class="col-md-2 mt-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="admin" value="true" 
                                           <%= editUser.isAdmin() ? "checked" : "" %>>
                                    <label class="form-check-label">Là Admin</label>
                                </div>
                            </div>
                            <div class="col-md-1 mt-4">
                                <button type="submit" class="btn btn-warning">Lưu</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        <% } %>

        <table class="table table-dark table-hover table-bordered">
            <thead>
                <tr class="text-warning">
                    <th>Username</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <% 
                // Duyệt vòng lặp Java thay cho <c:forEach>
                if (listUsers != null) {
                    for (Users u : listUsers) {
                %>
                    <tr>
                        <td><%= u.getId() %></td>
                        <td><%= u.getFullname() %></td>
                        <td><%= u.getEmail() %></td>
                        <td>
                            <%-- Logic hiển thị Badge --%>
                            <% if (u.isAdmin()) { %>
                                <span class="badge bg-danger">Admin</span>
                            <% } else { %>
                                <span class="badge bg-secondary">User</span>
                            <% } %>
                        </td>
                        <td>
                            <a href="QuanLyAccount?action=edit&id=<%= u.getId() %>" class="btn btn-sm btn-info">Sửa</a>
                            
                            <a href="QuanLyAccount?action=delete&id=<%= u.getId() %>" 
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Bạn có chắc muốn xóa user này?');">Xóa</a>
                        </td>
                    </tr>
                <% 
                    } // Kết thúc vòng for
                } // Kết thúc if check null
                %>
            </tbody>
        </table>
    </div>

	<jsp:include page="Footer.jsp"></jsp:include>
	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>