<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Chi Tiết Phim</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/Detail.css">
</head>

<body>
<jsp:include page="Header.jsp" />

<!-- KIỂM TRA CÓ PHIM -->
<c:choose>
<c:when test="${not empty movie}">

<div class="container my-5">
    <div class="row g-5">
        <div class="col-md-4">
            <img src="img/${movie.poster}" class="img-fluid"
                 style="width:100%; border-radius:12px;"
                 alt="${movie.title}">
        </div>

        <div class="col-md-8">
            <h1 class="display-5 fw-bold text-highlight mb-3">
                ${movie.title}
            </h1>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="badge-custom">
                    <i class='bx bx-hd'></i> ${movie.quality}
                </span>
                <span class="badge-custom">
                    <i class='bx bx-time'></i> ${movie.times} phút
                </span>
                <span class="badge-custom">
                    <i class='bx bx-calendar'></i> ${movie.formattedDayUpload}
                </span>

                <c:if test="${movie.vip}">
                    <span class="badge bg-warning text-dark">VIP</span>
                </c:if>
            </div>

            <div class="mb-4">
                <h5 class="text-highlight">Nội dung:</h5>
                <p style="color:#c9d1d9;">${movie.descriptions}</p>
            </div>

            <div class="d-flex gap-3 mt-3">

                <!-- LIKE -->
                <c:choose>
                    <c:when test="${not empty sessionScope.user}">
                        <button id="btnLike"
                                class="btn-action btn-like ${isLiked ? 'liked' : ''}">
                            <i class='bx ${isLiked ? "bxs-heart" : "bx-heart"}'></i>
                            <span id="txtLike">
                                ${isLiked ? "Đã Thích" : "Yêu Thích"}
                            </span>
                        </button>
                    </c:when>
                    <c:otherwise>
                        <button onclick="alert('Vui lòng đăng nhập để thích phim!')"
                                class="btn-action btn-like">
                            <i class='bx bx-heart'></i> Yêu Thích
                        </button>
                    </c:otherwise>
                </c:choose>

                <!-- SHARE -->
                <c:choose>
                    <c:when test="${not empty sessionScope.user}">
                        <button id="btnShare" class="btn-action btn-share">
                            <i class='bx bxs-share'></i>
                            Chia Sẻ (
                            <span id="shareCount">${movie.totalShares}</span>)
                        </button>
                    </c:when>
                    <c:otherwise>
                        <button onclick="alert('Vui lòng đăng nhập để chia sẻ phim!')"
                                class="btn-action btn-share">
                            <i class='bx bxs-share'></i>
                            Chia Sẻ (
                            <span id="shareCount">${movie.totalShares}</span>)
                        </button>
                    </c:otherwise>
                </c:choose>

            </div>
        </div>
    </div>

    <!-- VIDEO -->
    <div class="mt-5">
        <h3 class="text-highlight mb-3">
            <i class='bx bx-play-circle'></i> Xem Phim
        </h3>
        <div class="video-container">
            <iframe src="https://www.youtube.com/embed/${movie.link}"
                    title="Video player" frameborder="0"
                    allowfullscreen></iframe>
        </div>
    </div>

    <input type="hidden" id="hiddenVideoId" value="${movie.id}">

    <!-- PHIM LIÊN QUAN -->
    <div class="mt-5">
        <h3 class="text-highlight mb-4">Phim Liên Quan</h3>

        <div class="row row-cols-2 row-cols-md-4 g-4">
            <c:choose>
                <c:when test="${not empty listVideo}">
                    <c:forEach var="item" items="${listVideo}">
                        <div class="col">
                            <div class="card-clean">
                                <a href="DetailMovie?id=${item.id}">
                                    <img src="img/${item.poster}" alt="${item.title}">
                                </a>
                                <div class="card-body">
                                    <div class="card-title">${item.title}</div>
                                    <a href="DetailMovie?id=${item.id}"
                                       class="btn-watch-sm">
                                        Xem Ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </c:forEach>
                </c:when>
                <c:otherwise>
                    <div class="col-12">
                        <p style="color:#8b949e;">Không có phim liên quan</p>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</div>

</c:when>

<!-- KHÔNG CÓ PHIM -->
<c:otherwise>
    <div class="container text-center mt-5">
        <h3>Không tìm thấy phim!</h3>
    </div>
</c:otherwise>
</c:choose>

<jsp:include page="Footer.jsp" />

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<!-- JS LIKE & SHARE GIỮ NGUYÊN -->
<script>
    $(document).ready(function () {
        var vId = $('#hiddenVideoId').val();

        $('#btnLike').click(function () {
            var btn = $(this);
            var icon = btn.find('i');
            var txt = $('#txtLike');

            $.ajax({
                url: 'DetailMovie',
                type: 'POST',
                data: { action: 'like', id: vId },
                success: function (response) {
                    if (response === 'liked') {
                        txt.text('Đã Thích');
                        icon.removeClass('bx-heart').addClass('bxs-heart');
                        btn.addClass('liked');
                    } else if (response === 'unliked') {
                        txt.text('Yêu Thích');
                        icon.removeClass('bxs-heart').addClass('bx-heart');
                        btn.removeClass('liked');
                    }
                }
            });
        });

        $('#btnShare').click(function () {
            navigator.clipboard.writeText(window.location.href);
            alert("Đã sao chép liên kết phim!");

            $.post('DetailMovie',
                { action: 'share', id: vId },
                function (newCount) {
                    if (!isNaN(newCount)) {
                        $('#shareCount').text(newCount);
                    }
                });
        });
    });
</script>
</body>
</html>
